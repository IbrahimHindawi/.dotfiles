{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": " {{.Folder}} ",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#f7f7f7",
          "template": "[{{.UserName}}]"
        },
        {
          "type": "path",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " {{.Folder}}",
          "foreground": "#559e1a"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#7d7d7d",
          "template": "{{.HEAD}}",
          "options": {
            "branch_icon": " \ue0a0 "
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#81ff91",
          "foreground_templates": [
            "{{if gt .Code 0}}#ff3030{{end}}"
          ],
          "background": "transparent",
          "template": " >",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "palette": {
    "white": "#f7f7f7",
    "black": "#111111"
  }
}